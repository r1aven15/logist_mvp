[Unit]
Description=CargoHunt private CRM
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/workspace/project/crm
ExecStart=/usr/bin/python3 /workspace/project/crm/crm_server.py --port 12001 --host 0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
